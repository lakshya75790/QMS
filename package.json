{
  "name": "mediscan",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "codegen": "bunx drizzle-kit generate  --custom  --config=./src/lib/db/drizzle.config.ts",
    "push": "bunx drizzle-kit push  --config=./src/lib/db/drizzle.config.ts",
    "drop": "bunx drizzle-kit drop  --config=./src/lib/db/drizzle.config.ts",
    "migrate": "bun ./src/lib/db/migrate.ts",
    "db-studio": "bunx drizzle-kit studio  --config=./src/lib/db/drizzle.config.ts",
    "db-update": "bun run codegen && bun run migrate && bun run push",
    "prepare": "npx husky",
    "format": "pnpm prettier --write .",
    "gen-open-api":"bun gen/gen.ts"
  },
